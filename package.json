{
  "name": "studyroom",
  "version": "0.1.0",
  "private": true,
  "description": "StudyRoom – tanulószoba-foglaló webalkalmazás",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "node dist/db/migrate-cli.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@node-saml/passport-saml": "^5.1.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "luxon": "^3.7.2",
    "nodemailer": "^10.6.0",
    "nunjucks": "^3.2.4",
    "passport": "^0.7.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/nunjucks": "^3.2.6",
    "@types/passport": "^1.0.17",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}
