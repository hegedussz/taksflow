# StudyRoom – környezeti változók (éles vagy helyi futtatás docker nélkül)
# Másold .env néven, és töltsd ki. A .env fájlt ne commitold.

NODE_ENV=production
PORT=3000
# Az alkalmazás nyilvános címe; ebből készül a SAML entityID és az ACS-cím.
BASE_URL=https://studyroom.example.nye.hu
DATABASE_URL=postgres://studyroom:CHANGE_ME@db:5432/studyroom
# Legalább 32 véletlen karakter, pl.: openssl rand -base64 48
SESSION_SECRET=
# Fordított proxy (TLS-lezárás) mögött: true
TRUST_PROXY=true
SMTP_URL=smtp://user:pass@smtp.example.hu:587
MAIL_FROM=StudyRoom <noreply@example.nye.hu>
SEED_DEMO_DATA=false

# --- SAML2 / eduID (ADR-0003) ---
# Az egyetemi IdP adatai az eduID.hu föderációs metaadatból (SingleSignOnService, HTTP-Redirect).
SAML_IDP_SSO_URL=
SAML_IDP_ENTITY_ID=
# Az IdP aláíró tanúsítványa (PEM fájl vagy base64 érték)
SAML_IDP_CERT_FILE=/run/secrets/idp-signing.crt
# Az SP saját kulcspárja (ajánlott: titkosított assertionök fogadásához és a metaadatban közzétételhez)
SAML_SP_PRIVATE_KEY_FILE=/run/secrets/sp.key
SAML_SP_CERT_FILE=/run/secrets/sp.crt
# Ha a Response-t is aláírja az IdP (Shibboleth alapértelmezése), maradhat true.
SAML_WANT_RESPONSE_SIGNED=true
# Csak ezekről a domainekről (és aldomainjeikről) lehet belépni (eduPersonPrincipalName scope).
ALLOWED_SCOPES=nye.hu
# Adminisztrátorok eduPersonPrincipalName szerint, vesszővel elválasztva.
ADMIN_EPPNS=
